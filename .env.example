# Fila: "redis" (produção) ou "memory" (dev/testes, worker em thread no mesmo processo)
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Busca: "elasticsearch" (produção) ou "memory" (dev/testes)
SEARCH_BACKEND=memory
ELASTICSEARCH_URL=http://localhost:9200
# LLM: auto (Gemini se houver GEMINI_API_KEY, senão Anthropic) | gemini | anthropic
LLM_PROVIDER=auto
# Google AI Studio (chave em https://aistudio.google.com/apikey). Confirme o nome do modelo disponível na sua conta.
# ATENÇÃO: no nível gratuito os modelos "Pro" costumam ter cota ZERO (erro 429). Veja aistudio.google.com/rate-limit
# e use um modelo Flash/Flash-Lite com cota > 0. Liste os nomes exatos com o comando do README.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Modelo reserva se o principal ficar sobrecarregado (erro 503). Opcional. Ex.: gemini-3.6-flash
GEMINI_FALLBACK_MODEL=
# Esforço de raciocínio (low acelera; high = mais lento e mais caro) e tempo máximo por tentativa em segundos
GEMINI_THINKING=low
# Nível do modelo reserva, se diferente (ex.: minimal no principal e low no reserva). Vazio = igual ao principal
GEMINI_THINKING_FALLBACK=
GEMINI_TIMEOUT_S=240
# Texto máximo enviado à IA por processo (4 caracteres ≈ 1 token). 400000 ≈ 100 mil tokens; no nível gratuito use ~100000
CONTEXT_BUDGET_CHARS=400000
# Alternativa
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Mais rápido/barato: LLM_MODEL=claude-haiku-5-5. Esforço de raciocínio: low | medium | high
LLM_EFFORT=low
# OCR
OCR_LANG=por
OCR_DPI=200
MIN_TEXT_CHARS=40
DATA_DIR=./data
MAX_UPLOAD_MB=500
