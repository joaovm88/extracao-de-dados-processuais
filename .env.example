# Fila: "redis" (produção) ou "memory" (dev/testes, worker em thread no mesmo processo)
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Busca: "elasticsearch" (produção) ou "memory" (dev/testes)
SEARCH_BACKEND=memory
ELASTICSEARCH_URL=http://localhost:9200
# LLM do motor RAG (sem chave, o sistema responde de forma extrativa, só com trechos citados)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# OCR
OCR_LANG=por
OCR_DPI=200
MIN_TEXT_CHARS=40
DATA_DIR=./data
MAX_UPLOAD_MB=500
